# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173

MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/career_lens?retryWrites=true&w=majority
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.8-flash
GEMINI_FALLBACK_MODEL=gemini-3.5-flash

# Optional Gemini Flash Model Ladder Configuration
# Defines an ordered fallback chain of candidate Flash models (comma-separated):
# Supported: gemini-3.8-flash, gemini-3.7-flash, gemini-3.6-flash, gemini-3.5-flash, gemini-3.5-flash-lite
GEMINI_MODEL_CHAIN=gemini-3.8-flash,gemini-3.7-flash,gemini-3.6-flash,gemini-3.5-flash,gemini-3.5-flash-lite
# Maximum provider attempts allowed across entire ladder (default: 5, range: 1-5)
GEMINI_MAX_ATTEMPTS=5
# Total request deadline in milliseconds across all ladder attempts (default: 50000, range: 10000-120000)
GEMINI_DEADLINE_MS=50000
JWT_SECRET=your_jwt_secret_min_32_characters_here
JWT_EXPIRES_IN=1d
DAILY_ANALYSIS_LIMIT=20